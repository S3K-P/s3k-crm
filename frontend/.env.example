# ---------------------------------------------------------------------------
# S3K CRM frontend configuration
#
#   cp .env.example .env.local      # .env.local is git-ignored
#
# Required for local development. The backend runs on port 8000 via
# `npm run dev:backend`, so this is the value that matches the repo's own
# start script.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Leaving this unset is still supported, but it puts the app into its
# pre-integration state: no route is gated, every permission check returns
# true, and CRM pages render their local demonstration data. That mode exists
# so a clone runs without a backend — it is not how the application is meant
# to be developed or deployed.
#
# Only NEXT_PUBLIC_* values reach the browser. Never put a secret here.
