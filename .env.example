# ---------------------------------------------------------------------------
# Docker Compose infrastructure configuration (repo root)
#
# Copy to `.env` and set a local password. `.env` is git-ignored.
# These values only configure the local containers in docker-compose.yml.
# Application configuration lives in backend/.env (see backend/.env.example).
# ---------------------------------------------------------------------------

# PostgreSQL 18 (ADR-005)
# POSTGRES_PORT is the HOST port only (the container always listens on 5432).
# Change it if another PostgreSQL already owns 5432 on your machine, and keep
# backend/.env DATABASE_URL in sync.
POSTGRES_USER=s3k
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=s3k_crm
POSTGRES_PORT=5432

# Redis 7 (ADR-013 / tech stack assessment)
REDIS_PORT=6379

# FastAPI container (only started with: docker compose --profile backend up -d)
BACKEND_PORT=8000

# Object storage — MinIO locally, Cloudflare R2 in deployed environments
# (ADR-014). MinIO speaks the S3 API, so the application runs the same boto3
# code path against both; only the endpoint and credentials differ.
#
# STORAGE_SECRET_ACCESS_KEY is REQUIRED and has no default: `docker compose up`
# refuses to start without it. Pick any local value — it is not a real
# credential and must never match a deployed one.
STORAGE_BUCKET=s3k-attachments
STORAGE_ACCESS_KEY_ID=s3k-local
STORAGE_SECRET_ACCESS_KEY=change-me-locally
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
