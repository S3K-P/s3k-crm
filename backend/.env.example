# ---------------------------------------------------------------------------
# S3K CRM backend configuration
#
#   cp .env.example .env      # .env is git-ignored — never commit it
#
# Every value below is a safe local placeholder. DATABASE_URL and REDIS_URL are
# REQUIRED and have no application default: the process refuses to start when
# they are missing or malformed.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=s3k-crm-backend
# development | test | staging | production
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# --- PostgreSQL 18 (ADR-005) ----------------------------------------------
# REQUIRED. Must use the asyncpg driver. Credentials must match the values in
# the repo-root .env consumed by docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://s3k:change-me-locally@localhost:5432/s3k_crm

# Connection pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
# Logs every statement — must stay false in production.
DB_ECHO=false

# --- Redis 7 (ADR-013) -----------------------------------------------------
# REQUIRED.
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5.0

# --- Observability (ADR-018) ----------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# true = one JSON object per line; false = human-readable console output
LOG_JSON=false

# --- Email — Microsoft Graph (the only supported email transport) ----------
# Optional: leave unset in environments that never send email (e.g. most
# local dev). All four are required before any email can be sent — from the
# Azure AD app registration granted Mail.Send application permission.
# Never commit real values.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER_EMAIL=
