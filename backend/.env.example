# ---------------------------------------------------------------------------
# S3K CRM backend configuration
#
#   cp .env.example .env      # .env is git-ignored — never commit it
#
# Every value below is a safe local placeholder. DATABASE_URL and REDIS_URL are
# REQUIRED and have no application default: the process refuses to start when
# they are missing or malformed.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=s3k-crm-backend
# development | test | staging | production
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# --- PostgreSQL 18 (ADR-005) ----------------------------------------------
# REQUIRED. Must use the asyncpg driver.
#
# Note the role: `s3k_app`, NOT the `POSTGRES_USER` from the repo-root .env.
# That user is a SUPERUSER, and a superuser is exempt from every row-level
# security policy -- connecting the application as it means tenant isolation
# silently does not apply and every organization can read every other one's
# data. Outside development the application refuses to start as such a role.
#
# `s3k_app` is created by infra/postgres/init/10-application-role.sql when the
# postgres volume is first initialised. On a volume that predates it, create
# the role once by hand:
#
#   docker compose exec postgres psql -U s3k -d postgres #     -c "CREATE ROLE s3k_app LOGIN PASSWORD 'app-local-only' #         NOSUPERUSER NOCREATEDB CREATEROLE NOBYPASSRLS;" #     -c "CREATE DATABASE s3k_app OWNER s3k_app;"
#   cd backend && uv run alembic upgrade head
DATABASE_URL=postgresql+asyncpg://s3k_app:app-local-only@localhost:5432/s3k_app

# Connection pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
# Logs every statement — must stay false in production.
DB_ECHO=false

# --- Redis 7 (ADR-013) -----------------------------------------------------
# REQUIRED.
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5.0

# --- AI gateway (ADR-016) --------------------------------------------------
# Powers AI Insights > Market Insights: company research through Claude with
# server-side web search.
#
# OPTIONAL, and unset is a supported state — not a broken one. Without a key
# the AI endpoints answer 503 `ai_not_configured` and the interface shows
# "AI is not connected". Nothing is ever faked in its place.
#
# The key is read only by the backend. It is never sent to the browser, never
# echoed in a response, and is held as a SecretStr so it stays out of logs and
# tracebacks. Leave it blank here; put the real value in backend/.env, which is
# git-ignored.
ANTHROPIC_API_KEY=

# Which vendor the gateway calls: `anthropic` or `gemini`. Only the selected
# provider's key is read — holding the other one is not a fallback.
#
#   anthropic  Claude with its web_search server tool. Sources come back as
#              real publisher URLs with page titles. Paid, no free tier.
#   gemini     Gemini with Google Search grounding. Flash models have a free
#              token allowance and the 3.x generation includes a monthly
#              allowance of grounded searches, so this runs at no cost within
#              those limits. Grounding returns Google redirect links rather
#              than publisher URLs, so the backend resolves each one before
#              storing it, and source titles are only publisher domains.
AI_PROVIDER=anthropic

# Google AI Studio key, used only when AI_PROVIDER=gemini.
# GOOGLE_API_KEY is accepted as an alias — both names are in circulation.
# Free to create at https://aistudio.google.com/apikey — no card required.
# Same handling as the Anthropic key: backend-only, SecretStr, never echoed.
GEMINI_API_KEY=

# Pinned deliberately: changing the model changes what new research says.
AI_MODEL=claude-opus-5
# The Gemini counterpart. Flash is the tier with a free allowance.
GEMINI_MODEL=gemini-3.8-flash
# Every call is streamed, so a large ceiling costs nothing until it is used.
AI_MAX_OUTPUT_TOKENS=64000
# Web searches per research turn — caps latency and spend.
AI_WEB_SEARCH_MAX_USES=8
# A deep research turn legitimately runs for minutes.
AI_REQUEST_TIMEOUT_SECONDS=300
# How many times a paused server-tool turn is resumed before giving up.
AI_MAX_CONTINUATIONS=4
# Research turns per user per hour.
AI_RATE_LIMIT_PER_HOUR=40

# --- Observability (ADR-018) ----------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# true = one JSON object per line; false = human-readable console output
LOG_JSON=false

# --- Authentication (ADR-009) ---------------------------------------------
# Ed25519 keypair in PEM format, used to sign and verify access tokens.
# REQUIRED when ENVIRONMENT is staging or production; startup aborts without
# them. In development they may be omitted, in which case an ephemeral keypair
# is generated per process (tokens then die on restart).
#
# Generate with:
#   openssl genpkey -algorithm ed25519 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
#
# Newlines may be written as literal \n if your secret store cannot hold them.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ISSUER=s3k-platform
JWT_AUDIENCE=s3k-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Password policy -------------------------------------------------------
PASSWORD_MIN_LENGTH=12

# --- Brute-force protection ------------------------------------------------
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Refresh cookie --------------------------------------------------------
REFRESH_COOKIE_NAME=s3k_refresh
# COOKIE_DOMAIN=

# --- CORS (doc 13) ---------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Empty = same-origin
# only. A wildcard is not supported: credentialed requests (the refresh cookie)
# require an explicit origin.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Object storage (ADR-014, doc 13) --------------------------------------
# Cloudflare R2 in deployed environments, MinIO locally. Both speak the S3 API,
# so the same boto3 code path runs against either — only these values change.
#
# REQUIRED when ENVIRONMENT is staging or production; the process refuses to
# start without them there. Left blank in development, the attachment endpoints
# report 503 "storage not configured" instead of accepting uploads that cannot
# land anywhere.
#
# Never commit real credentials. For R2 these are an R2 API token's access key
# pair, and the endpoint is https://<account-id>.r2.cloudflarestorage.com.
STORAGE_BUCKET=s3k-attachments
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=s3k-local
STORAGE_SECRET_ACCESS_KEY=change-me-locally
# R2 ignores the region but boto3 requires one. Leave as "auto" for R2.
STORAGE_REGION=auto
# R2 and MinIO address buckets by path, not by subdomain.
STORAGE_FORCE_PATH_STYLE=true
# Set only when the browser reaches storage on a different host than the API
# does — e.g. the API in Docker talking to http://minio:9000 while the browser
# uses http://localhost:9000. Leave unset in production.
# STORAGE_PUBLIC_ENDPOINT_URL=
# Pre-signed URL lifetimes, in seconds (doc 13 specifies 15 minutes).
STORAGE_DOWNLOAD_URL_TTL_SECONDS=900
STORAGE_UPLOAD_URL_TTL_SECONDS=900

# The bucket must allow cross-origin PUT and GET from the frontend origin, or
# the browser's direct upload is blocked before it reaches storage. MinIO
# permits all origins by default; on R2 configure CORS on the bucket to allow
# PUT/GET from the origins in CORS_ALLOWED_ORIGINS above.
